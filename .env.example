# Safe for browser: Supabase project URL and publishable key only.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_example

# Server-only. Never use this value in browser code.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVER_ONLY_SUPABASE_SERVICE_ROLE_KEY

# Server-only Google Sheets service-account credentials.
GOOGLE_SERVICE_ACCOUNT_EMAIL=sheets-reader@your-project.iam.gserviceaccount.com
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="YOUR_GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY_WITH_LITERAL_\\n_NEWLINES"

# Server-only Google OAuth web-client credentials.
GOOGLE_CLIENT_ID=YOUR_GOOGLE_OAUTH_WEB_CLIENT_ID.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_OAUTH_WEB_CLIENT_SECRET
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/api/google/oauth/callback

# Server-only base64url-encoded 32-byte key used for AES-256-GCM.
TOKEN_ENCRYPTION_KEY=YOUR_BASE64URL_ENCODED_32_BYTE_KEY

# Safe default. preview never enqueues or calls Gmail; draft creates drafts only; live sends.
EMAIL_MODE=preview
EMAIL_BATCH_SIZE=5

# Optional comma-separated safety gate for every Gmail draft/send operation.
TEST_RECIPIENT_ALLOWLIST=

# Server-only random secret (32+ characters) used to protect the cron endpoint.
CRON_SECRET=YOUR_RANDOM_CRON_SECRET_AT_LEAST_32_CHARACTERS

APP_URL=http://localhost:3000
